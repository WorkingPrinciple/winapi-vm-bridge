{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WinAPI VM Bridge adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapter", "windows", "operations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$" },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dll", "sha256"],
      "properties": {
        "dll": { "type": "string", "pattern": "^[^/\\\\]+\\.dll$" },
        "sha256": { "type": "string", "pattern": "^(replace-at-install|[0-9a-f]{64})$" }
      }
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["export", "callingConvention", "timeoutMs", "parameters", "returns"],
        "properties": {
          "export": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_@]*$" },
          "callingConvention": { "enum": ["cdecl", "stdcall", "winapi"] },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "direction"],
              "properties": {
                "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "type": {
                  "enum": ["i32", "u32", "i64", "u64", "f32", "f64", "bool", "hresult", "utf8", "utf16", "bytes", "opaque_handle", "custom"]
                },
                "direction": { "enum": ["in", "out", "inout"] },
                "maxBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
                "notes": { "type": "string", "maxLength": 2000 }
              }
            }
          },
          "returns": {
            "enum": ["void", "i32", "u32", "i64", "u64", "bool", "hresult", "custom"]
          },
          "notes": { "type": "string", "maxLength": 4000 }
        }
      }
    }
  }
}

