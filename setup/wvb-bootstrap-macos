#!/bin/sh
set -eu

usage() {
  echo "usage: wvb-bootstrap-macos <setup|update|rollback|uninstall|doctor> [package-dir]" >&2
  exit 64
}

operation=${1:-}
package_dir=${2:-}
[ -n "$operation" ] || usage

install_root=${WVB_INSTALL_ROOT:-"$HOME/Library/Application Support/WinApiVmBridge/runtime"}

verify_release() {
  manifest=$1
  if [ "${WVB_ALLOW_UNSIGNED:-0}" = "1" ]; then
    echo "warning: unsigned development package explicitly allowed" >&2
    return
  fi
  verifier=${WVB_SIGNATURE_VERIFIER:-}
  [ -n "$verifier" ] || {
    echo "WVB_SIGNATURE_VERIFIER is required for release packages" >&2
    exit 65
  }
  "$verifier" "$manifest"
}

package_cli() {
  cli="$package_dir/bin/wvb-package"
  [ -x "$cli" ] || {
    echo "package lifecycle binary is missing: $cli" >&2
    exit 66
  }
  printf '%s\n' "$cli"
}

verify_envelope() {
  root=$1
  manifest=$2
  python3 - "$root" "$manifest" <<'PY'
import hashlib
import json
import sys
from pathlib import Path, PurePosixPath

root = Path(sys.argv[1]).resolve()
document = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
if document.get("schema") != "winapi-vm-bridge.release-envelope.v1":
    raise SystemExit("invalid release envelope")
for entry in document.get("files", []):
    relative = PurePosixPath(entry["path"])
    if relative.is_absolute() or ".." in relative.parts or "." in relative.parts:
        raise SystemExit(f"invalid release path: {relative}")
    path = (root / Path(*relative.parts)).resolve()
    if root not in path.parents or not path.is_file():
        raise SystemExit(f"release path escaped: {relative}")
    if hashlib.sha256(path.read_bytes()).hexdigest() != entry["sha256"]:
        raise SystemExit(f"release hash mismatch: {relative}")
PY
}

case "$operation" in
  setup|update)
    [ -d "$package_dir" ] || usage
    release_manifest="$package_dir/release-manifest.json"
    manifest="$package_dir/runtime-package.json"
    [ -f "$manifest" ] || {
      echo "runtime package manifest is missing" >&2
      exit 66
    }
    [ -f "$release_manifest" ] || {
      echo "release envelope is missing" >&2
      exit 66
    }
    verify_release "$release_manifest"
    verify_envelope "$package_dir" "$release_manifest"
    cli=$(package_cli)
    "$cli" verify --source "$package_dir/payload" --manifest "$manifest"
    "$cli" stage \
      --root "$install_root" \
      --source "$package_dir/payload" \
      --manifest "$manifest"
    health=$(mktemp)
    trap 'rm -f "$health"' EXIT
    runtime="$install_root/versions/$(python3 -c \
      'import json,sys; print(json.load(open(sys.argv[1]))["package_version"])' \
      "$manifest")/bin/wvb-runtime"
    [ -x "$runtime" ] || {
      echo "staged runtime is missing: $runtime" >&2
      exit 66
    }
    "$runtime" init-state --state "$install_root/state.db"
    "$runtime" doctor \
      --state "$install_root/state.db" \
      --package-root "$install_root/versions/$(python3 -c \
        'import json,sys; print(json.load(open(sys.argv[1]))["package_version"])' \
        "$manifest")" \
      --receipt "$health"
    "$cli" activate \
      --root "$install_root" \
      --manifest "$manifest" \
      --health-receipt "$health"
    ;;
  rollback)
    [ -n "$package_dir" ] || usage
    package_dir=$package_dir
    "$(package_cli)" rollback --root "$install_root"
    ;;
  uninstall)
    [ -n "$package_dir" ] || usage
    version=$package_dir
    cli=${WVB_PACKAGE_CLI:-"$install_root/bin/wvb-package"}
    "$cli" uninstall-preflight --root "$install_root" --version "$version"
    [ "${WVB_CONFIRM_UNINSTALL:-0}" = "1" ] || {
      echo "set WVB_CONFIRM_UNINSTALL=1 after reviewing the preflight" >&2
      exit 67
    }
    "$cli" uninstall --root "$install_root" --version "$version"
    ;;
  doctor)
    active="$install_root/active.jcs"
    [ -f "$active" ] || {
      echo "runtime is not active" >&2
      exit 68
    }
    version=$(python3 -c \
      'import json,sys; print(json.load(open(sys.argv[1]))["package_version"])' \
      "$active")
    "$install_root/versions/$version/bin/wvb-runtime" doctor \
      --state "$install_root/state.db" \
      --package-root "$install_root/versions/$version"
    ;;
  *)
    usage
    ;;
esac
