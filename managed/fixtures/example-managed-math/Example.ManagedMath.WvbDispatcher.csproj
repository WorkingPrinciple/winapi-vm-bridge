<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Example.ManagedMath.WvbDispatcher</AssemblyName>
    <RootNamespace>Wvb.Generated</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Dispatcher.generated.cs" />
    <Reference Include="Example.ManagedMath">
      <HintPath>lib/Example.ManagedMath.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
