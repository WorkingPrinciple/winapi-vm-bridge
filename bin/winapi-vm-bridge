#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
if [ "${1:-}" = init ] && [ -n "${2:-}" ]; then
  name=$2
  target=${3:-adapter.json}
  sed "s/vendor\\.library/$name/g" "$root/sdk/templates/adapter.json" > "$target"
  echo "$target"
  exit 0
fi
if [ "${1:-}" = generate ] && [ -n "${2:-}" ]; then
  shift
  exec python3 "$root/sdk/generate.py" "$@"
fi
if [ "${1:-}" = adapters ]; then
  printf '{"adapters":["core"],"note":"Install generated manifests to add Windows DLL adapters."}\n'
  exit 0
fi
if [ "${1:-}" = call ]; then
  PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m winapi_vm_bridge.cli "$@"
fi
cat >&2 <<'EOF'
Usage:
  winapi-vm-bridge init vendor.library [adapter.json]
  winapi-vm-bridge generate adapter.json --out generated
  winapi-vm-bridge call core.ping --json
  winapi-vm-bridge adapters --json

The public bootstrap includes the paired core ping adapter. Native DLL
adapters require their documented Windows SDK/runtime and explicit manifest.
EOF
exit 2
